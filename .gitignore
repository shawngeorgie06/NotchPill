# Xcode / Swift
# `build/` is what build-release.sh uses; the suffixed ones are throwaway
# derived-data paths from one-off builds, and each is well over 100MB.
build/
build-*/
dist/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
Package.resolved

# macOS
.DS_Store

# Xcode workspace user data
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Scratch / tool build artifacts
tools/mousemove

# Coverage
default.profraw
*.profraw

# Vendored MediaRemote adapter (clone via Scripts/setup-vendor.sh)
Vendor/

# Vendored MediaRemote adapter build output
Vendor/mediaremote-adapter/build/
build-dev/
